@model Valuer_Verification_System.Models.ViewModels.ValuerRowDetailsVm
@using Valuer_Verification_System.Models.Data

<!-- marker for JS to read the valuation key -->
<span id="rowDetailsValuationKey" data-vkey="@Model.ValuationKey" style="display:none;"></span>

<style>
    /* ── scoped styles for the partial ── */
    .rd-wrap {
        font-family: 'Poppins', sans-serif;
        padding: 22px 24px;
    }

    /* top hero strip */
    .rd-hero {
        background: #0d0d0d;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .rd-hero::before {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(230,176,0,.22) 0%, transparent 70%);
            border-radius: 50%;
        }

    .rd-hero-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        background: linear-gradient(135deg, #f5cd4a, #b88a00);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 3px 14px rgba(230,176,0,.45);
        position: relative;
        z-index: 1;
    }

    .rd-hero-body {
        flex: 1;
        position: relative;
        z-index: 1;
    }

    .rd-hero-label {
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: rgba(255,255,255,.42);
        margin-bottom: 3px;
    }

    .rd-hero-key {
        font-size: 1.1rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.01em;
    }

    .rd-hero-desc {
        font-size: .74rem;
        color: rgba(255,255,255,.5);
        margin-top: 3px;
    }

    /* status badge hero */
    .rd-hero-status {
        position: relative;
        z-index: 1;
    }

    /* section blocks */
    .rd-section {
        margin-bottom: 18px;
    }

    .rd-section-title {
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #b88a00;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .rd-section-title::before {
            content: '';
            display: inline-block;
            width: 8px;
            height: 8px;
            background: #e6b000;
            border-radius: 2px;
            flex-shrink: 0;
        }

    /* fields grid */
    .rd-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }

        .rd-grid.cols-2 {
            grid-template-columns: 1fr 1fr;
        }

        .rd-grid.cols-3 {
            grid-template-columns: 1fr 1fr 1fr;
        }

    .rd-field {
    }

    .rd-field-label {
        font-size: .64rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #9a9a9a;
        margin-bottom: 3px;
    }

    .rd-field-val {
        font-size: .85rem;
        font-weight: 600;
        color: #0d0d0d;
    }

        .rd-field-val.large {
            font-size: 1rem;
            font-weight: 800;
            color: #0d0d0d;
        }

        .rd-field-val.mono {
            font-family: 'Courier New', monospace;
            font-size: .82rem;
        }

    /* batch card */
    .rd-batch-card {
        background: #f9f9f9;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        padding: 13px 16px;
    }

    .rd-batch-name {
        font-size: .88rem;
        font-weight: 700;
        color: #0d0d0d;
        margin-bottom: 3px;
    }

    .rd-batch-date {
        font-size: .74rem;
        color: #9a9a9a;
    }

    .rd-batch-week {
        font-size: .74rem;
        color: #4a4a4a;
        margin-top: 2px;
    }

    /* decision row */
    .rd-decision-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .rd-decision-comment {
        font-size: .79rem;
        color: #4a4a4a;
        background: #f9f9f9;
        border: 1px solid #e2e2e2;
        border-left: 3px solid #e6b000;
        border-radius: 8px;
        padding: 9px 12px;
        margin-top: 8px;
        font-style: italic;
    }

    .rd-decision-time {
        font-size: .71rem;
        color: #9a9a9a;
    }

    /* decision badges */
    .rd-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 13px;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 700;
    }

        .rd-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            flex-shrink: 0;
        }

    .rd-badge-pending {
        background: #fff3d6;
        color: #b06800;
        border: 1px solid #f0d078;
    }

    .rd-badge-yes {
        background: #e8f8ef;
        color: #1a8a4a;
        border: 1px solid #b2dfcc;
    }

    .rd-badge-no {
        background: #fdeaea;
        color: #c0272d;
        border: 1px solid #f5b4b6;
    }

    /* mv highlight */
    .rd-mv {
        background: rgba(230,176,0,.09);
        border: 1px solid rgba(230,176,0,.28);
        border-radius: 8px;
        padding: 10px 14px;
        display: inline-block;
    }

        .rd-mv .rd-field-label {
            color: #b88a00;
        }

        .rd-mv .rd-field-val {
            font-size: 1.05rem;
            font-weight: 800;
            color: #0d0d0d;
        }
</style>

<div class="rd-wrap">

    <!-- HERO -->
    <div class="rd-hero">
        <div class="rd-hero-icon">🏠</div>
        <div class="rd-hero-body">
            <div class="rd-hero-label">Valuation Key</div>
            <div class="rd-hero-key">@Model.ValuationKey</div>
            <div class="rd-hero-desc">@Model.PropertyDescription</div>
        </div>
        <div class="rd-hero-status">
            @if (Model.Decision == VerificationDecision.Pending)
            {
                <span class="rd-badge rd-badge-pending">⏳ Pending</span>
            }
            else if (Model.Decision == VerificationDecision.Yes)
            {
                <span class="rd-badge rd-badge-yes">✔ Verified</span>
            }
            else
            {
                <span class="rd-badge rd-badge-no">✕ Rejected</span>
            }
        </div>
    </div>

    <!-- PROPERTY DETAILS -->
    <div class="rd-section">
        <div class="rd-section-title">Property Details</div>
        <div class="rd-grid cols-3" style="margin-bottom:12px;">
            <div class="rd-field">
                <div class="rd-field-label">Sector</div>
                <div class="rd-field-val">@(Model.Sector ?? "—")</div>
            </div>
            <div class="rd-field">
                <div class="rd-field-label">Category</div>
                <div class="rd-field-val">@(Model.Category ?? "—")</div>
            </div>
            <div class="rd-field">
                <div class="rd-field-label">Property Type</div>
                <div class="rd-field-val">@(Model.PropertyType ?? "—")</div>
            </div>
        </div>
        <div style="margin-bottom:12px;">
            <div class="rd-mv">
                <div class="rd-field-label">Market Value</div>
                <div class="rd-field-val">
                    @(Model.MarketValue.HasValue ? $"R {Model.MarketValue.Value:N2}" : "—")
                </div>
            </div>
        </div>
        <div class="rd-field">
            <div class="rd-field-label">Assigned Valuer</div>
            <div class="rd-field-val">@(Model.AssignedToValuer ?? "—")</div>
        </div>
    </div>

    <!-- BATCH INFO -->
    <div class="rd-section">
        <div class="rd-section-title">Batch Information</div>
        <div class="rd-batch-card">
            <div class="rd-batch-name">@Model.BatchName</div>
            <div class="rd-batch-date">Batch date: @Model.BatchDate.ToString("dd MMM yyyy")</div>
            <div class="rd-batch-week">
                Week: @Model.WeekStart.ToString("dd MMM yyyy") → @Model.WeekEnd.ToString("dd MMM yyyy")
                &nbsp;|&nbsp; Notice send: @Model.NoticeSendDate.ToString("dd MMM yyyy")
            </div>
        </div>
    </div>

    <!-- CURRENT DECISION -->
    <div class="rd-section">
        <div class="rd-section-title">Current Decision</div>
        <div class="rd-decision-row">
            @if (Model.Decision == VerificationDecision.Pending)
            {
                <span class="rd-badge rd-badge-pending">⏳ Pending</span>
                <span class="rd-decision-time">No decision recorded yet</span>
            }
            else if (Model.Decision == VerificationDecision.Yes)
            {
                <span class="rd-badge rd-badge-yes">✔ Yes — Verified</span>
                @if (Model.DecisionAtUtc.HasValue)
                {
                    <span class="rd-decision-time">@Model.DecisionAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</span>
                }
            }
            else
            {
                <span class="rd-badge rd-badge-no">✕ No — Rejected</span>
                @if (Model.DecisionAtUtc.HasValue)
                {
                    <span class="rd-decision-time">@Model.DecisionAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</span>
                }
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.DecisionComment))
        {
            <div class="rd-decision-comment">"@Model.DecisionComment"</div>
        }
    </div>

</div>
