<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Valuer Verification System</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Valuer_Verification_System.styles.css" asp-append-version="true" />
    <link href="~/css/layout.css" rel="stylesheet" />
</head>

@{
        // ── User context (set in AppBaseController) ─────────────────────────
        string appFullName = ViewBag.AppUserFullName as string ?? User.Identity?.Name ?? "Unknown";
        string appRole = ViewBag.AppUserRole as string ?? string.Empty;
        string appInitials = ViewBag.AppUserInitials as string ?? "?";

        // ── Page permissions (from RolePermissions in appsettings) ──────────
        var pages = ViewBag.AppUserPages as IReadOnlySet<string>
                ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        bool Can(string key) => pages.Contains(key);

        // ── Default landing by role ─────────────────────────────────────────
        string defaultController = "Home";
        string defaultAction = "Index";

        if (appRole.Equals("Valuer", StringComparison.OrdinalIgnoreCase))
        {
                defaultController = "Valuer";
                defaultAction = "Dashboard";
        }
        else if (appRole.Equals("Valuer Manager", StringComparison.OrdinalIgnoreCase))
        {
                defaultController = "Manager";
                defaultAction = "Dashboard";
        }
}
<body>

    <!-- ═════════════════════════ NAVIGATION ═════════════════════════ -->
    <nav class="site-nav">

        <!-- Brand (ROLE-AWARE) -->
        <a class="nav-brand" asp-area="" asp-controller="@defaultController" asp-action="@defaultAction">
            <div class="nav-brand-icon"><i class="bi bi-bar-chart-fill"></i></div>
            <div>
                <div class="nav-brand-text">Valuation <span>VS</span></div>
                <div class="nav-brand-sub">Verification System</div>
            </div>
        </a>

        <div class="nav-divider"></div>

        <!-- Desktop Nav -->
        <ul class="nav-links">

            @if (Can("Home"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-fill"></i> Home
                    </a>
                </li>
            }

            @if (Can("WeekWindows"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="WeekWindows" asp-action="Index">
                        <i class="bi bi-calendar-week"></i> Week Windows
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="DataTeam" asp-action="SendNotice">
                        <i class="bi bi-calendar-week"></i> Send Notice
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/DataTeam/Stats">
                        <i class="bi bi-calendar-week"></i> Official Stats
                    </a>
                </li>
            }

            @if (Can("ValuerInbox"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Valuer" asp-action="Inbox">
                        <i class="bi bi-inbox-fill"></i> My Inbox
                    </a>
                </li>
            }

            @if (Can("ValuerDashboard"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Valuer" asp-action="Dashboard">
                        <i class="bi bi-person-badge"></i> Valuer Dashboard
                    </a>
                </li>
            }

            @if (Can("ManagerDashboard"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Manager" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> Manager Dashboard
                    </a>
                </li>
            }

            @if (Can("Reassign"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Manager" asp-action="Reassign">
                        <i class="bi bi-arrow-left-right"></i> Reassign
                    </a>
                </li>
            }

            @if (Can("Home"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-shield-lock"></i> Privacy
                    </a>
                </li>
            }
        </ul>

        <!-- User -->
        <div class="nav-right">
            <div class="nav-user">
                <div class="nav-avatar">@appInitials</div>
                <div class="nav-user-info">
                    <span class="nav-user-label">@appRole</span>
                    <span class="nav-user-name">@appFullName</span>
                </div>
            </div>
        </div>

        <!-- Mobile toggler -->
        <button class="nav-toggler" id="navToggler">
            <i class="bi bi-list"></i>
        </button>
    </nav>

    <!-- ═════════════════════════ MAIN ═════════════════════════ -->
    <div class="site-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ═════════════════════════ FOOTER ═════════════════════════ -->
    <footer class="site-footer">
        <div class="footer-bottom">
            <span>&copy; 2026 <strong>Valuer Verification System</strong></span>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
