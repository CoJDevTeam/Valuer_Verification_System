@using Valuer_Verification_System.Services.Roll
@model List<RollPrepRow>
@{
    var confirm = (ViewBag.Mode as string) == "confirm";
    ViewData["Title"] = confirm ? "Roll Confirmation" : "Valuation Roll";
    var batches = ViewBag.Batches as List<RollBatchOption> ?? new List<RollBatchOption>();
    string Link(int id) => confirm ? $"/Roll/Confirm/{id}" : $"/Roll/{id}";
}
<link href="~/css/manager/ManagerHome.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/roll/Roll.css" rel="stylesheet" asp-append-version="true" />

<div class="mgr">
    <div class="mgr-top">
        <div>
            <div class="mgr-eyebrow">@(confirm ? "Valuation Department" : "Data Team")</div>
            <h1>@(confirm ? "Roll" : "Valuation Roll") <span>@(confirm ? "Confirmation" : "Preparation")</span></h1>
            <div class="mgr-sub">
                @(confirm
                    ? "Review the entries the Data Team submitted and decide which must be printed in the roll."
                    : "Build the roll from the properties the valuers marked Yes, add related reviews and amendments, then submit for confirmation.")
            </div>
        </div>
        @if (!confirm)
        {
            <div class="mgr-actions">
                <button class="mgr-btn primary" type="button" data-bs-toggle="modal" data-bs-target="#createModal"><i class="bi bi-plus-circle-fill"></i> New roll</button>
            </div>
        }
    </div>

    @if (TempData["Success"] != null) { <div class="mgr-alert ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="mgr-alert bad"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div> }

    <div class="mgr-card">
        <header><h2>@(confirm ? "Rolls submitted" : "Rolls")</h2></header>
        @if (Model.Count == 0)
        {
            <div class="mgr-empty">@(confirm ? "Nothing has been submitted for confirmation yet." : "No rolls yet. Use New roll to start from a verified batch.")</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table>
                    <thead>
                        <tr><th>Roll</th><th>GV</th><th>Period</th><th>Batch</th><th>Entries</th><th>Undecided</th><th>Include</th><th>Exclude</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><b>@r.RollNumber</b><div class="sub">@r.RollType</div></td>
                            <td>@r.GV</td>
                            <td>@r.RollPeriod</td>
                            <td>@r.BatchName</td>
                            <td>@r.Entries</td>
                            <td>@r.Pending</td>
                            <td>@r.Included</td>
                            <td>@r.Excluded</td>
                            <td><span class="roll-status @r.Status.ToLower()">@r.Status</span></td>
                            <td><a class="mgr-btn" href="@Link(r.Id)">@(confirm && r.Status == "Submitted" ? "Review" : "Open")</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (!confirm)
{
    <div class="modal fade rs-modal" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="/Roll/Create">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-journal-plus me-2"></i>New <span class="gold">valuation roll</span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="rs-label">Verified batch</div>
                            <select name="BatchId" required>
                                <option value="">Select batch</option>
                                @foreach (var b in batches) { <option value="@b.Id">@b.Name | @b.Date.ToString("yyyy-MM-dd")</option> }
                            </select>
                            <div class="rs-hint">Every property in the batch marked Yes is added to the roll.</div>
                        </div>
                        <div class="mb-3"><div class="rs-label">Roll type description</div><input type="text" name="RollType" required /></div>
                        <div class="roll-grid">
                            <div><div class="rs-label">Roll number</div><input type="text" name="RollNumber" required /></div>
                            <div><div class="rs-label">GV</div><input type="text" name="GV" required /></div>
                        </div>
                        <div class="mt-3"><div class="rs-label">Valuation roll period</div><input type="text" name="RollPeriod" required placeholder="e.g. 1 July 2026 to 30 June 2027" /></div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="rs-out" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="rs-gold">Create roll</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
