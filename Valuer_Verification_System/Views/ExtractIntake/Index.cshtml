@model Valuer_Verification_System.Controllers.ExtractIntakeIndexVm

@{
    ViewData["Title"] = "Extracts - Step 1";
    var newFiles = Model.FilesInFolder.Count(f => !f.Imported);
}

<link href="~/css/upload/intake-css.css" rel="stylesheet" />
<link href="~/css/upload/intake-steps.css" rel="stylesheet" />

<div class="intake-page">
    <div class="intake-shell">

        <div class="hero">
            <div class="hero__eyebrow">Extracts · Step 1 of 4</div>
            <h1>Extracts in the folder</h1>
            <p>
                The Data Team puts the extract in the folder. Here you see every file, which ones are already imported,
                and what to do next for each extract.
            </p>
        </div>

        @await Html.PartialAsync("_IntakeSteps", (1, (int?)null, false, false))

        @if (TempData["ExtractIntakeSuccess"] is string ok)
        {
            <div class="alert ok">@ok</div>
        }
        @if (TempData["ExtractIntakeError"] is string err)
        {
            <div class="alert err">@err</div>
        }

        <div class="grid">
            <div class="card">
                <h2>Folder</h2>
                <div class="folder-path">@Model.FolderPath</div>
                @if (Model.FolderExists)
                {
                    <div class="alert ok" style="margin-top:12px;margin-bottom:0;">Folder found.</div>
                }
                else
                {
                    <div class="alert err" style="margin-top:12px;margin-bottom:0;">
                        Folder not found. Check <code>ExtractInbox:FolderPath</code> in appsettings.
                    </div>
                }

                <div class="step-actions">
                    @if (Model.ImportIsRunning)
                    {
                        <span class="pill warn">
                            An import is running (started @(Model.ImportStartedAtUtc?.ToString("HH:mm") ?? "-") UTC by @Model.ImportStartedBy)
                        </span>
                    }
                    else if (Model.CanRunFolderImportNow)
                    {
                        <form method="post" action="/ExtractIntake/RunNow">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-run-now">
                                <i class="bi bi-arrow-repeat"></i> Check the folder and import new files
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="small-muted">The folder is also checked automatically every day.</span>
                    }
                </div>
            </div>

            <div class="card">
                <h2>Files in the folder <span class="small-muted">(@Model.FilesInFolder.Count, @newFiles new)</span></h2>

                @if (!Model.FilesInFolder.Any())
                {
                    <p class="small-muted">No extract files in the folder.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>File</th>
                                <th class="num">Size</th>
                                <th>Modified</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FilesInFolder)
                            {
                                <tr>
                                    <td>@f.FileName</td>
                                    <td class="num">@f.SizeDisplay</td>
                                    <td>@f.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (f.Imported)
                                        {
                                            <span class="pill ok">Imported as @f.BatchName</span>
                                        }
                                        else
                                        {
                                            <span class="pill warn">New, not imported yet</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card full" style="margin-bottom:20px;">
            <h2>Imported extracts and what to do next</h2>

            @if (!Model.Batches.Any())
            {
                <p class="small-muted">Nothing imported yet.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Extract</th>
                            <th>File</th>
                            <th>Week</th>
                            <th class="num">Rows</th>
                            <th>Week table</th>
                            <th>Where it is now</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Batches)
                        {
                            <tr>
                                <td><strong>@b.BatchName</strong></td>
                                <td>@b.OriginalFileName</td>
                                <td>@b.WeekStart.ToString("dd MMM") to @b.WeekEnd.ToString("dd MMM yyyy")</td>
                                <td class="num">@b.TotalRows.ToString("N0")</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(b.CleanWeekTableName))
                                    {
                                        <span class="pill grey">Not created</span>
                                    }
                                    else
                                    {
                                        <span class="small-muted">@b.CleanWeekTableName</span>
                                    }
                                </td>
                                <td>
                                    @if (b.NextStep == 4 && b.ManagersNotifiedAtUtc != null)
                                    {
                                        <span class="pill ok">@b.NextStepText</span>
                                    }
                                    else if (string.Equals(b.ExtractCleaningStatus, "Failed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pill err">@b.NextStepText</span>
                                    }
                                    else
                                    {
                                        <span class="pill warn">@b.NextStepText</span>
                                    }
                                </td>
                                <td style="white-space:nowrap;">
                                    @if (b.NextStep == 2)
                                    {
                                        <a class="btn primary" href="/ExtractIntake/Clean/@b.BatchId">Step 2: Clean</a>
                                    }
                                    else if (b.NextStep == 3)
                                    {
                                        <a class="btn primary" href="/ExtractIntake/Notify/@b.BatchId">Step 3: Email managers</a>
                                    }
                                    else
                                    {
                                        <a class="btn gray" href="/ExtractIntake/Notify/@b.BatchId">Details</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <details>
            <summary>Folder check log (last @Model.Audits.Count)</summary>
            @if (!Model.Audits.Any())
            {
                <p class="small-muted">No folder checks logged yet.</p>
            }
            else
            {
                <div class="card">
                    <table>
                        <thead>
                            <tr><th>When</th><th>Type</th><th>By</th><th class="num">New</th><th class="num">Skipped</th><th class="num">Failed</th><th>Message</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Audits)
                            {
                                <tr>
                                    <td>@a.StartedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                    <td>@a.RunType</td>
                                    <td>@a.StartedBy</td>
                                    <td class="num">@a.ImportedCount</td>
                                    <td class="num">@a.SkippedCount</td>
                                    <td class="num">@a.FailedCount</td>
                                    <td>@(a.ErrorMessage ?? a.Message)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </details>

    </div>
</div>
