@model Valuer_Verification_System.Models.ViewModels.SendNoticeStep2Vm
@{
    ViewData["Title"] = "Send Notices – Step 2: Validate Clean Data";

    string PassFail(bool ok) => ok ? "check-pass" : "check-fail";
    string PassFailText(bool ok) => ok ? "PASS" : "FAIL";
}

<link href="~/css/DataTeam/SendNotice.css" rel="stylesheet" />
<link href="~/css/noticesent/noticesentstep2css.css" rel="stylesheet" />
<link href="~/css/noticesent/noticesentcss.css" rel="stylesheet" />

<div class="sn-wrapper">

    <header class="sn-header">
        <div>
            <div class="sn-eyebrow">Valuation Verification System · Data Team</div>
            <h1 class="sn-title">Send Notices <span>— Step 2</span></h1>
            <p class="sn-subtitle">
                Validate the cleaned and verified extract before inserting into the Week Table.
            </p>
        </div>

        <a href="/DataTeam/SendNotice" class="btn-outline">← Back to Step 1</a>
    </header>

    <div class="step-bar">
        <div class="step done">
            <span class="step-num">✓</span>
            <span class="step-label">Select Week</span>
        </div>
        <div class="step-line done"></div>

        <div class="step active">
            <span class="step-num">2</span>
            <span class="step-label">Validate Clean Data</span>
        </div>
        <div class="step-line"></div>

        <div class="step">
            <span class="step-num">3</span>
            <span class="step-label">Print Notices</span>
        </div>
        <div class="step-line"></div>

        <div class="step">
            <span class="step-num">4</span>
            <span class="step-label">Confirm &amp; Send</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="sn-content">

        <div class="card">
            <div class="card-header">
                <span class="card-icon">✅</span>
                <span>Clean Data Validation — Batch @Model.BatchId</span>
            </div>

            <div class="card-body">

                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Batch</span>
                        <span class="info-value">@Model.BatchName</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Extraction Date</span>
                        <span class="info-value">@Model.ExtractionDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Letter Date</span>
                        <span class="info-value">@Model.NoticeSendDate.ToString("dd MMM yyyy").ToUpperInvariant()</span>
                    </div>

                    <div class="info-item span-2">
                        <span class="info-label">Target Week Table</span>
                        <span class="info-value table-name">@Model.WeekTableName</span>
                    </div>
                </div>

                <hr />

                <h4 class="section-title">Verification Summary</h4>

                <div class="summary-grid">
                    <div class="summary-card">
                        <div class="summary-label">Total Rows</div>
                        <div class="summary-value">@Model.TotalRows</div>
                    </div>

                    <div class="summary-card warning">
                        <div class="summary-label">Pending</div>
                        <div class="summary-value">@Model.Pending</div>
                    </div>

                    <div class="summary-card success">
                        <div class="summary-label">Yes</div>
                        <div class="summary-value">@Model.Yes</div>
                    </div>

                    <div class="summary-card danger">
                        <div class="summary-label">No</div>
                        <div class="summary-value">@Model.No</div>
                    </div>

                    <div class="summary-card">
                        <div class="summary-label">Send Notice = Y</div>
                        <div class="summary-value">@Model.SendNoticeYes</div>
                    </div>
                </div>

                <h4 class="section-title mt-4">Clean Data Checks</h4>

                <div class="check-list">

                    <div class="check-row @PassFail(Model.TotalRows > 0)">
                        <div>
                            <strong>Rows loaded</strong>
                            <div class="check-hint">Batch must contain uploaded extract rows.</div>
                        </div>
                        <span>@PassFailText(Model.TotalRows > 0)</span>
                    </div>

                    <div class="check-row @PassFail(Model.Pending == 0)">
                        <div>
                            <strong>All valuers completed verification</strong>
                            <div class="check-hint">Pending records must be 0 before notices can continue.</div>
                        </div>
                        <span>@Model.Pending pending</span>
                    </div>

                    <div class="check-row @PassFail(Model.MissingSector == 0)">
                        <div>
                            <strong>Sector populated</strong>
                            <div class="check-hint">All records must have Sector after cleaning.</div>
                        </div>
                        <span>@Model.MissingSector missing</span>
                    </div>

                    <div class="check-row @PassFail(Model.MissingPremiseId == 0)">
                        <div>
                            <strong>Premise ID populated</strong>
                            <div class="check-hint">PremiseId is required for notice generation.</div>
                        </div>
                        <span>@Model.MissingPremiseId missing</span>
                    </div>

                    <div class="check-row @PassFail(Model.MissingUsername == 0)">
                        <div>
                            <strong>Valuer username resolved</strong>
                            <div class="check-hint">Valuer must be linked to UserManagement where applicable.</div>
                        </div>
                        <span>@Model.MissingUsername missing</span>
                    </div>

                    <div class="check-row @PassFail(Model.WeekTableExists)">
                        <div>
                            <strong>Week table exists</strong>
                            <div class="check-hint">If missing, the insert step will create/prep it before printing.</div>
                        </div>
                        <span>@(Model.WeekTableExists ? "Exists" : "Not found yet")</span>
                    </div>

                </div>

                @if (Model.ExtractCleanedAtUtc != null || !string.IsNullOrWhiteSpace(Model.ExtractCleaningStatus))
                {
                    <div class="clean-note">
                        <strong>Cleaning Status:</strong> @Model.ExtractCleaningStatus
                        @if (Model.ExtractCleanedAtUtc != null)
                        {
                            <span> · @Model.ExtractCleanedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ExtractCleaningMessage))
                        {
                            <div>@Model.ExtractCleaningMessage</div>
                        }
                    </div>
                }

            </div>
        </div>

    </div>

    <div class="sn-footer-bar">
        <div class="sn-footer-left">
            @if (Model.ReadyToInsert)
            {
                <span class="footer-table-status exists">
                    ✅ Batch is ready. Proceed to insert verified rows into @Model.WeekTableName.
                </span>
            }
            else
            {
                <span class="footer-table-status missing">
                    ⚠ Batch is not ready. Fix failed checks before continuing.
                </span>
            }
        </div>

        <div class="sn-footer-right">
            <a class="btn-outline" href="/DataTeam/SendNotice/Step2/@Model.BatchId">
                Refresh Status
            </a>

            <form method="post" action="/DataTeam/SendNotice/InsertWeekTable" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" value="@Model.BatchId" />

                <button class="btn-gold btn-print-notices"
                        type="submit"
                    @(Model.ReadyToInsert ? "" : "disabled")>
                    Proceed to Insert Week Table →
                </button>
            </form>
        </div>
    </div>

</div>

<style>
    .sn-wrapper {
        padding-bottom: 5rem;
    }

    .section-title {
        font-size: .95rem;
        font-weight: 800;
        color: #1c1c1c;
        margin-bottom: 1rem;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 1rem;
    }

    .summary-card {
        background: #fafafa;
        border: 1px solid #e8e0cc;
        border-radius: 12px;
        padding: 1rem;
    }

        .summary-card.success {
            background: #e8f8ef;
            border-color: #b2dfcc;
        }

        .summary-card.warning {
            background: #fff8e0;
            border-color: #f0d078;
        }

        .summary-card.danger {
            background: #fdeaea;
            border-color: #f0b3b6;
        }

    .summary-label {
        font-size: .7rem;
        color: #777;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .summary-value {
        font-size: 1.6rem;
        font-weight: 900;
        color: #111;
    }

    .check-list {
        border: 1px solid #e8e0cc;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }

    .check-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.2rem;
        border-bottom: 1px solid #eee6d8;
        align-items: center;
    }

        .check-row:last-child {
            border-bottom: none;
        }

        .check-row span {
            font-weight: 900;
            font-size: .8rem;
            border-radius: 999px;
            padding: .35rem .7rem;
            white-space: nowrap;
        }

    .check-pass span {
        background: #e8f8ef;
        color: #1a8a4a;
        border: 1px solid #b2dfcc;
    }

    .check-fail span {
        background: #fdeaea;
        color: #c0272d;
        border: 1px solid #f0b3b6;
    }

    .check-hint {
        font-size: .78rem;
        color: #777;
        margin-top: .2rem;
    }

    .clean-note {
        margin-top: 1.2rem;
        background: #f8f8f8;
        border-left: 4px solid #e6b000;
        padding: .9rem 1rem;
        border-radius: 10px;
        font-size: .82rem;
        color: #555;
    }

    .sn-footer-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-top: 2px solid #e8e0cc;
        padding: .85rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 -4px 18px rgba(0,0,0,.08);
        z-index: 100;
    }

    .sn-footer-right {
        display: flex;
        gap: .8rem;
        align-items: center;
    }

    .footer-table-status {
        font-size: .82rem;
        font-weight: 700;
    }

        .footer-table-status.exists {
            color: #1a8a4a;
        }

        .footer-table-status.missing {
            color: #a05a00;
        }

    .btn-print-notices:disabled {
        background: #e8e0cc !important;
        color: #aaa !important;
        cursor: not-allowed;
        box-shadow: none;
    }

    @@media(max-width: 900px) {
        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .sn-footer-bar {
            flex-direction: column;
            gap: .8rem;
            align-items: stretch;
        }

        .sn-footer-right {
            justify-content: flex-end;
        }
    }
</style>