@model Valuer_Verification_System.Models.ViewModels.PrintNoticeVm
@{
    ViewData["Title"] = "Send Notices – Step 3: Print";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Print Notices – Step 3</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="~/css/DataTeam/SendNotice.css" rel="stylesheet"/>
    <link href="~/css/noticesent/sentnoticestep3css1.css" rel="stylesheet" />
</head>
<body>
<div class="page">

  <!-- TOP BAR -->
  <div class="top-bar">
    <div class="top-bar__left">
      <div class="eyebrow">Valuation Verification System · Data Team</div>
      <div class="page-title">Send Notices <span>— Step 3: Print</span></div>
      <div class="page-sub">Select a week, preview the notice &amp; email, then print all PDFs to the output folder.</div>
    </div>
    <a href="/" class="btn-back">← Dashboard</a>
  </div>

  <!-- STEPPER -->
  <div class="stepper">
    <div class="stp done"><span class="stp-n">✓</span><span class="stp-l">Select Week</span></div>
    <div class="stp-line done"></div>
    <div class="stp done"><span class="stp-n">✓</span><span class="stp-l">Clean Data</span></div>
    <div class="stp-line done"></div>
    <div class="stp active"><span class="stp-n">3</span><span class="stp-l">Print Notices</span></div>
    <div class="stp-line"></div>
    <div class="stp"><span class="stp-n">4</span><span class="stp-l">Confirm &amp; Send</span></div>
  </div>

  <!-- ══ WEEK SELECTOR — standalone dark bar, NO card wrapper ══ -->
  <div class="week-selector">
    <span class="week-selector__label">📋 Week / Batch</span>
    <select id="batchSel" onchange="onBatchChange(this.value)">
                @foreach (var b in Model.AvailableBatches)
                {
                    <option value="@b.Id"
                            data-table="@b.WeekTableName"
                            data-count="@b.NoticeCount"
                            selected="@(Model.SelectedBatchId == b.Id)">
                        @b.BatchName — @b.NoticeSendDate.ToString("dd MMM yyyy") (@b.NoticeCount notices)
                    </option>
                }
    </select>
    <div class="week-meta">
      <span class="week-chip">Table: <strong id="metaTable">@Model.WeekTableName</strong></span>
      <span class="week-chip">Notices: <strong id="metaCount">@Model.TotalNotices</strong></span>
    </div>
  </div>

  <!-- ══ BODY GRID: PDF LEFT | DATES + EMAIL RIGHT ══ -->
  <div class="body-grid">

    <!-- LEFT: PDF -->
    <div class="card">
      <div class="card-hd">
        <span class="card-hd__ico">📄</span>
        <span class="card-hd__ttl">Notice PDF Preview — First Sendable Property</span>
        <button class="card-hd__btn" onclick="loadPdf()">↺ Refresh</button>
      </div>
      <div class="card-body" style="padding:.75rem;">
        <div class="pdf-box" id="pdfBox">
          <div class="pdf-spin" id="pdfSpin">
            <div class="spin"></div>
            <span>Loading PDF…</span>
          </div>
          <iframe id="pdfFrame"></iframe>
        </div>
      </div>
    </div>

    <!-- RIGHT: DATES + EMAIL -->
    <div class="right">

      <div class="card">
        <div class="card-hd">
          <span class="card-hd__ico">📅</span>
          <span class="card-hd__ttl">Notice Dates</span>
        </div>
        <div class="card-body">
          <div class="date-list">
            <div class="date-row primary">
              <span class="date-row__ico">📬</span>
              <div>
                <div class="date-row__lbl">Letter Date</div>
                <div class="date-row__val" id="dLetter">@Model.NoticeSendDate.ToString("dd MMMM yyyy").ToUpperInvariant()</div>
              </div>
            </div>
            <div class="date-row">
              <span class="date-row__ico">🗓</span>
              <div>
                <div class="date-row__lbl">Objection Period Opens</div>
                <div class="date-row__val" id="dOpen">@Model.ReviewOpenDate.ToString("dd MMMM yyyy").ToUpperInvariant()</div>
              </div>
            </div>
            <div class="date-row">
              <span class="date-row__ico">⏰</span>
              <div>
                <div class="date-row__lbl">Objection Deadline</div>
                <div class="date-row__val" id="dClose">@Model.ReviewCloseDate.ToString("dd MMMM yyyy").ToUpperInvariant()</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-hd">
          <span class="card-hd__ico">📧</span>
          <span class="card-hd__ttl">Client Email Preview</span>
          <button class="card-hd__btn" onclick="reloadEmail()">↺ Refresh</button>
        </div>
        <div class="card-body" style="padding:0;">
          <div class="email-shell">
            <iframe id="emailFrame"></iframe>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- STATS -->
  <div class="stats">
    <div class="stat gold">
      <div class="stat__lbl">Total Notices</div>
      <div class="stat__val" id="sTot">@Model.TotalNotices</div>
      <div class="stat__sub">ValuationKey groups</div>
    </div>
    <div class="stat">
      <div class="stat__lbl">Single Properties</div>
      <div class="stat__val" id="sSgl">@Model.SingleCount</div>
      <div class="stat__sub">1-row notices</div>
    </div>
    <div class="stat">
      <div class="stat__lbl">Multipurpose</div>
      <div class="stat__val" id="sMlt">@Model.MultiPurposeCount</div>
      <div class="stat__sub">split-row notices</div>
    </div>
    <div class="stat green">
      <div class="stat__lbl">Output Folder</div>
      <div class="stat__val" id="sFolder" style="font-size:.72rem;word-break:break-all;font-weight:800;line-height:1.3;">
        @System.IO.Path.GetFileName(Model.OutputFolderDisplay)
      </div>
      <div class="stat__sub">Notices folder</div>
    </div>
  </div>

  <!-- FOLDER PATH -->
  <div class="folder-strip">
    <span>📁</span>
    <span class="folder-strip__path" id="folderPath">@Model.OutputFolderDisplay</span>
  </div>

  <!-- PRINT PROGRESS -->
  <div class="prog-card">
    <div class="prog-hd">
      <span class="prog-hd__title">🖨&nbsp; Print Progress</span>
      <span class="prog-badge" id="progBadge">Ready</span>
    </div>
    <div class="prog-body">

      <div class="prog-top">
        <div>
          <div class="prog-count"><span id="progDone">0</span> / <span id="progTot">@Model.TotalNotices</span> notices</div>
          <div class="prog-sub">printed to output folder</div>
        </div>
        <div class="prog-pct" id="progPct">0%</div>
      </div>

      <div class="prog-bar-outer">
        <div class="prog-bar-inner" id="progBar" style="width:0%;"></div>
      </div>

      <div class="cur-prop">
        <div class="cur-prop__lbl">Currently printing</div>
        <div class="cur-prop__val" id="curProp">—</div>
      </div>

      <div id="errLog" class="err-log"></div>

      <div id="doneBanner" class="done-banner">
        <span class="done-ico">✅</span>
        <div>
          <div class="done-h">All notices printed successfully!</div>
          <div class="done-p">Saved to: <span id="donePath" class="done-path"></span></div>
        </div>
      </div>

      <div class="action-row">
        <button id="btnPrint" class="btn-print" onclick="startPrint()">🖨&nbsp; Print All Notices</button>
                    <a id="btnNext" class="btn-next" href="#">Proceed to QA Preview →</a>
      </div>

    </div>
  </div>

</div><!-- /page -->
<script>
// ── state ─────────────────────────────────────────────────────────────────────
let BATCH_ID      = @Model.SelectedBatchId;
let WEEK_TABLE    = "@Model.WeekTableName";
let TOTAL         = @Model.TotalNotices;
const CHUNK       = 25;
let printing      = false;

// ── batch change ──────────────────────────────────────────────────────────────
async function onBatchChange(id) {
  BATCH_ID = parseInt(id);
  resetProgress();
  setDates('…','…','…');

  try {
    const r = await fetch(`/DataTeam/SendNotice/PrintDetails/${BATCH_ID}`);
    if (!r.ok) throw new Error(r.status);
    const d = await r.json();

    WEEK_TABLE = d.weekTableName;
    TOTAL      = d.totalNotices;

    setDates(d.letterDate, d.reviewOpenDate, d.reviewCloseDate);

    setText('metaTable', d.weekTableName);
    setText('metaCount', d.totalNotices);
    setText('sTot',      d.totalNotices);
    setText('sSgl',      d.singleCount);
    setText('sMlt',      d.multiCount);
    setText('progTot',   d.totalNotices);
    setText('folderPath',d.outputFolder);
    setText('sFolder',   d.outputFolder.split(/[/\\]/).pop());

    loadPdf();
    if (d.emailHtml) renderEmail(d.emailHtml);

  } catch(e) {
    console.error('PrintDetails failed:', e);
    setDates('Error','Error','Error');
  }
}

function setDates(l,o,c){
  setText('dLetter', l);
  setText('dOpen',   o);
  setText('dClose',  c);
}
function setText(id, val){ document.getElementById(id).textContent = val; }

// ── PDF ───────────────────────────────────────────────────────────────────────
function loadPdf() {
  const f = document.getElementById('pdfFrame');
  const s = document.getElementById('pdfSpin');
  f.style.display = 'none';
  s.style.display = 'flex';
  f.onload  = ()=>{ s.style.display='none'; f.style.display='block'; };
  f.onerror = ()=>{ s.innerHTML='<span>⚠ Could not load PDF</span>'; };
  f.src = `/DataTeam/SendNotice/PreviewPdf/${BATCH_ID}?t=${Date.now()}`;
}

// ── Email ─────────────────────────────────────────────────────────────────────
// Use Blob URL so the full HTML document renders correctly in the iframe
let _emailBlobUrl = null;
function renderEmail(html) {
  if (_emailBlobUrl) URL.revokeObjectURL(_emailBlobUrl);
  const blob = new Blob([html], { type: 'text/html; charset=utf-8' });
  _emailBlobUrl = URL.createObjectURL(blob);
  document.getElementById('emailFrame').src = _emailBlobUrl;
}

async function reloadEmail(){
  try {
    const r = await fetch(`/DataTeam/SendNotice/PrintDetails/${BATCH_ID}`);
    const d = await r.json();
    if (d.emailHtml) renderEmail(d.emailHtml);
  } catch(e){ console.error(e); }
}

// ── Print loop ────────────────────────────────────────────────────────────────
async function startPrint(){
  if(printing) return;
  printing = true;
  const btn = document.getElementById('btnPrint');
  btn.disabled  = true;
  btn.innerHTML = '⏳&nbsp; Printing…';
  setText('progBadge','Running');
  document.getElementById('doneBanner').classList.remove('show');
  document.getElementById('errLog').className = 'err-log';
  document.getElementById('errLog').innerHTML = '';

  let offset=0, done=0;
  while(true){
    const r = await fetch('/DataTeam/SendNotice/PrintChunk',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({batchId:BATCH_ID, weekTableName:WEEK_TABLE, offset, chunkSize:CHUNK})
    });
    const d = await r.json();

    if(!d.success){ appendErrors(d.errors); setText('progBadge','❌ Error'); break; }

    done   += d.printed;
    offset += CHUNK;   // always advance by chunk size — server uses Skip(offset) absolutely
    const total = d.total || TOTAL;
    setProgress(done, total, d.currentProperty);
    if(d.errors?.length) appendErrors(d.errors);
    // done when server says so, or we've sent past the total
    if(d.done || offset >= total){ showDone(done, total); break; }
    await new Promise(r=>setTimeout(r,60));
  }

  printing = false;
  btn.disabled  = false;
  btn.innerHTML = '🖨&nbsp; Print All Notices';
}

function setProgress(done, total, cur){
  const pct = total>0 ? Math.round(done/total*100) : 0;
  document.getElementById('progBar').style.width = pct+'%';
  setText('progDone', done);
  setText('progTot',  total);
  setText('progPct',  pct+'%');
  if(cur) setText('curProp', cur);
}

function showDone(done, total){
  setText('progBadge','✅ Done');
  document.getElementById('doneBanner').classList.add('show');
  setText('donePath', document.getElementById('folderPath').textContent);
  setProgress(done, total, '— complete —');
  const btn = document.getElementById('btnNext');
              btn.href = `/DataTeam/SendNotice/QA/${BATCH_ID}?weekTableName=${encodeURIComponent(WEEK_TABLE)}`;
  btn.classList.add('show');
}

function resetProgress(){
  document.getElementById('progBar').style.width = '0%';
  setText('progDone','0'); setText('progPct','0%');
  setText('curProp','—'); setText('progBadge','Ready');
  document.getElementById('doneBanner').classList.remove('show');
  document.getElementById('btnNext').classList.remove('show');
}

function appendErrors(errors){
  if(!errors?.length) return;
  const log = document.getElementById('errLog');
  log.classList.add('show');
  errors.forEach(e=>{ const d=document.createElement('div'); d.textContent='⚠ '+e; log.appendChild(d); });
}

// ── init ──────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', ()=>{
  if(BATCH_ID > 0) onBatchChange(BATCH_ID);
});
</script>
</body>
</html>
