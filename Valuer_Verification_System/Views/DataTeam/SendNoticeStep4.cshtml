@model Valuer_Verification_System.Models.ViewModels.SendNoticeStep4Vm
@{
    ViewData["Title"] = "Send Notices \u2013 Step 4";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Send Notices \u2013 Step 4</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
   

    <link href="~/css/noticesent/noticesentcss.css" rel="stylesheet" />
</head>
<body>
    <div class="sn-wrapper">

        <!-- PAGE HEADER -->
        <header class="sn-header">
            <div>
                <div class="sn-eyebrow">Valuer Verification System \u00b7 Data Team</div>
                <h1 class="sn-title">Send Notices <span>\u2014 Step 4</span></h1>
                <p class="sn-subtitle">Review the send summary then confirm to mark notices as sent.</p>
            </div>
            <a href="/" class="btn-outline">\u2190 Dashboard</a>
        </header>

        <!-- STEP INDICATOR -->
        <div class="step-bar">
            <div class="step done"><span class="step-num">✓</span><span class="step-label">Select Week</span></div>
            <div class="step-line done"></div>
            <div class="step done"><span class="step-num">✓</span><span class="step-label">Clean Data</span></div>
            <div class="step-line done"></div>
            <div class="step done"><span class="step-num">✓</span><span class="step-label">Print Notices</span></div>
            <div class="step-line done"></div>
            <div class="step active"><span class="step-num">4</span><span class="step-label">Confirm &amp; Send</span></div>
        </div>

        <div class="sn-content">

            @if (Model.AlreadySent)
            {
                <!-- ALREADY SENT BANNER -->
                <div class="card">
                    <div class="card-header" style="background:#1a8a4a;">
                        <span class="card-icon">\u2705</span>
                        <span>Notices Already Sent \u2014 @Model.BatchName</span>
                    </div>
                    <div class="card-body">
                        <div class="success-box" style="border-left-color:#1a8a4a;">
                            Notices for batch <strong>@Model.BatchName</strong> were already sent on
                            <strong>@Model.SentAtUtc?.ToString("dd MMMM yyyy")</strong>
                            at <strong>@Model.SentAtUtc?.ToString("HH:mm")</strong>
                            by <strong>@Model.SentBy</strong>.
                        </div>
                        <div style="margin-top:1.4rem;">
                            <a href="/" class="btn-gold">\u2190 Back to Dashboard</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- SEND SUMMARY CARD -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-icon">\U0001f4ec</span>
                        <span>Send Summary \u2014 @Model.BatchName</span>
                    </div>
                    <div class="card-body">

                        <!-- Stat cards row -->
                        <div class="stats-grid" style="margin-bottom:1.6rem;">
                            <div class="stat-card">
                                <div class="stat-label">Batch</div>
                                <div class="stat-value" style="font-size:1.15rem;font-weight:700;">@Model.BatchName</div>
                            </div>
                            <div class="stat-card stat-green">
                                <div class="stat-label">\U0001f4ec Notices to Send</div>
                                <div class="stat-value">@Model.NoticeSendCount.ToString("N0")</div>
                                <div class="stat-sub">SendNotice = Y &amp; Decision = Yes</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Total Rows in Batch</div>
                                <div class="stat-value">@Model.TotalRows.ToString("N0")</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Week Table (173 server)</div>
                                <div class="stat-value" style="font-size:.82rem;word-break:break-all;font-weight:600;">@Model.WeekTableName</div>
                            </div>
                        </div>

                        <!-- Date summary table -->
                        <table class="date-table" style="margin-bottom:1.6rem;">
                            <thead>
                                <tr>
                                    <th>Letter Date (Notice Send Date)</th>
                                    <th>Review Opens</th>
                                    <th>Review Closes (+ 60 days)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>@Model.NoticeSendDate.ToString("dd MMMM yyyy").ToUpperInvariant()</strong></td>
                                    <td><strong>@Model.ReviewOpenDate.ToString("dd MMMM yyyy").ToUpperInvariant()</strong></td>
                                    <td><strong>@Model.ReviewCloseDate.ToString("dd MMMM yyyy").ToUpperInvariant()</strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Info box -->
                        <div class="info-box" style="background:#fff8e0;border-left:4px solid #e6b000;padding:1rem 1.2rem;border-radius:8px;margin-bottom:1.8rem;font-size:.875rem;">
                            <strong>\u2139\ufe0f  What happens when you confirm:</strong>
                            <ul style="margin:.6rem 0 0 1.2rem;line-height:1.9;">
                                <li>Batch <strong>@Model.BatchName</strong> status is set to <strong>Sent</strong>.</li>
                                <li>The Week Window status is updated to <strong>Sent</strong>.</li>
                                <li>Your username and timestamp are recorded as the sender.</li>
                                <li>The cleaned data in <strong>@Model.WeekTableName</strong> on the 173 server is ready for QUEST.</li>
                                <li>This action <strong>cannot be undone</strong>.</li>
                            </ul>
                        </div>

                        <!-- Warning if zero notices -->
                        @if (Model.NoticeSendCount == 0)
                        {
                            <div style="background:#fdeaea;border-left:4px solid #c0272d;padding:1rem 1.2rem;border-radius:8px;margin-bottom:1.4rem;font-size:.875rem;color:#c0272d;">
                                <strong>\u26a0\ufe0f  Warning:</strong> No rows have SendNotice = Y with a Yes decision.
                                Confirm only if you are sure the week table has been created correctly.
                            </div>
                        }

                        <!-- Confirm form -->
                        <form method="post" action="/DataTeam/SendNotice/ConfirmSend">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="batchId" value="@Model.BatchId" />
                            <input type="hidden" name="weekTableName" value="@Model.WeekTableName" />

                            <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin-top:.5rem;">
                                <button type="submit"
                                        class="btn-confirm-send"
                                        onclick="return confirm('Confirm: mark notices as sent for batch @Model.BatchName?\n\n@Model.NoticeSendCount.ToString(" N0") notice(s) will be recorded as sent.\n\nThis cannot be undone.')">
                                    \u2713 Confirm &mdash; Mark Notices as Sent
                                </button>
                                <a href="/DataTeam/SendNotice/Step3/@Model.BatchId" class="btn-outline">
                                    \u2190 ← Back to Print
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            }

        </div>
    </div>
</body>
</html>
