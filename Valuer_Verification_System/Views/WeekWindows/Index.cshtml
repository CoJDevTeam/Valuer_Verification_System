@using DocumentFormat.OpenXml.Drawing.Charts
@model List<Valuer_Verification_System.Models.Data.WeekWindow>
@{
    ViewData["Title"] = "Week Windows";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Week Windows</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/weekwindow/indexcss.css" rel="stylesheet" />
</head>
<body>
    <div class="dash-wrapper">

        <header class="page-header">
            <div>
                <div class="page-eyebrow">Valuation Verification System</div>
                <h1 class="page-title">Week <span>Windows</span></h1>
            </div>
            <a class="btn btn-gold" href="/WeekWindows/Create">Create</a>
        </header>

        <div class="panel">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Week Start (Mon)</th>
                            <th>Week End (Sun)</th>
                            <th>Notice Send Date</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model)
                        {
                            <tr>
                                <td>@w.WeekStart.ToString("yyyy-MM-dd")</td>
                                <td>@w.WeekEnd.ToString("yyyy-MM-dd")</td>
                                <td>@w.NoticeSendDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="status-badge">@w.Status</span></td>
                                <td><a class="view-link" href="/WeekWindows/Details/@w.Id">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</body>
</html>
