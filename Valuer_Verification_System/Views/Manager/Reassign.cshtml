@model Valuer_Verification_System.Models.ViewModels.ReassignVm
@{
    ViewData["Title"] = "Reassign Valuer";

    var rowsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Rows.ToDictionary(r => r.ExtractRowId.ToString(), r => new
        {
            vkey = r.ValuationKey,
            premise = r.PremiseId,
            sector = r.Sector,
            desc = r.PropertyDescription,
            address = r.Address,
            town = r.Town,
            category = r.Category,
            value = r.MarketValue.HasValue ? r.MarketValue.Value.ToString("N0") : null,
            owner = r.Owner,
            scheme = r.SchemeName,
            unit = r.UnitNo,
            lis = r.ExtractValuer,
            from = r.CurrentValuer
        }));

    var valuersJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ActiveValuers.Select(v => new { u = v.Username, n = v.FullName, s = v.Sector, p = v.Position }));
}

<link href="~/css/manager/ManagerHome.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/manager/ReassignPage.css" rel="stylesheet" asp-append-version="true" />

<div class="mgr">

    <div class="mgr-top">
        <div>
            <div class="mgr-eyebrow">Valuation Manager</div>
            <h1>Reassign <span>Valuer</span></h1>
            <div class="mgr-sub">Move Pending properties to an active valuer. Verified properties cannot be moved.</div>
        </div>
        <div class="mgr-actions">
            <a class="mgr-btn" asp-controller="Manager" asp-action="Dashboard" asp-route-batchId="@Model.BatchId"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <button type="button" class="mgr-btn primary" data-bs-toggle="modal" data-bs-target="#bulkModal"><i class="bi bi-people-fill"></i> Bulk reassign</button>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="mgr-alert ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="mgr-alert bad"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div> }

    <div class="mgr-filters">
        <form method="get" action="/Manager/Reassign">
            <div>
                <label>Batch</label>
                <select name="batchId" onchange="this.form.submit()">
                    @foreach (var b in Model.Batches)
                    {
                        <option value="@b.Id" selected="@(b.Id == Model.BatchId)">@b.BatchName | @b.BatchDate.ToString("yyyy-MM-dd")</option>
                    }
                </select>
            </div>
            <div>
                <label>Current valuer</label>
                <select name="currentValuer">
                    <option value="">All valuers</option>
                    @foreach (var v in Model.CurrentValuers)
                    {
                        <option value="@v.Username" selected="@string.Equals(v.Username, Model.CurrentValuer, StringComparison.OrdinalIgnoreCase)">@v.Username (@v.Pending pending)</option>
                    }
                </select>
            </div>
            <div>
                <label>Sector</label>
                <select name="sector">
                    <option value="">All sectors</option>
                    @foreach (var s in Model.Sectors)
                    {
                        <option value="@s" selected="@string.Equals(s, Model.Sector, StringComparison.OrdinalIgnoreCase)">@s</option>
                    }
                </select>
            </div>
            <div>
                <label>Top records</label>
                <input type="number" name="top" min="1" max="2000" value="@Model.Top" />
            </div>
            <button class="mgr-btn primary" type="submit"><i class="bi bi-funnel-fill"></i> Apply filters</button>
        </form>
    </div>

    <div class="mgr-kpis">
        <div class="mgr-kpi"><label>Showing</label><b>@Model.Rows.Count.ToString("N0")</b></div>
        <div class="mgr-kpi"><label>Valuers holding work</label><b>@Model.CurrentValuers.Count(x => x.Username != "Unassigned")</b></div>
        <div class="mgr-kpi pend"><label>Unassigned</label><b>@(Model.CurrentValuers.FirstOrDefault(x => x.Username == "Unassigned")?.Pending.ToString("N0") ?? "0")</b></div>
        <div class="mgr-kpi"><label>Sectors</label><b>@Model.Sectors.Count</b></div>
    </div>

    <div class="mgr-card">
        <header>
            <h2>Pending properties</h2>
            <input class="mgr-search" id="rowSearch" type="search" placeholder="Search premise ID, valuation key, description, valuer…" />
        </header>

        @if (Model.Rows.Count == 0)
        {
            <div class="mgr-empty">No Pending properties match these filters.</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table id="rowsTable">
                    <thead>
                        <tr>
                            <th>Sector</th>
                            <th>Valuation key</th>
                            <th>Premise ID</th>
                            <th>Property description</th>
                            <th>Current valuer</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var none = r.CurrentValuer == "Unassigned";
                            <tr>
                                <td><span class="sector-pill">@r.Sector</span></td>
                                <td><span class="vkey">@r.ValuationKey</span></td>
                                <td><span class="prem">@(string.IsNullOrWhiteSpace(r.PremiseId) ? "-" : r.PremiseId)</span></td>
                                <td class="desc">
                                    <b>@(string.IsNullOrWhiteSpace(r.PropertyDescription) ? "(no description)" : r.PropertyDescription)</b>
                                    @if (!string.IsNullOrWhiteSpace(r.Address)) { <span>@r.Address</span> }
                                </td>
                                <td>
                                    <div class="who @(none ? "none" : "")">
                                        <i>@(r.CurrentValuer.Length >= 2 ? r.CurrentValuer.Substring(0, 2).ToUpper() : "?")</i>
                                        <div>@r.CurrentValuer
                                            @if (!string.IsNullOrWhiteSpace(r.ExtractValuer)) { <div class="sub">LIS: @r.ExtractValuer</div> }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="mgr-btn" data-bs-toggle="modal" data-bs-target="#reassignModal" data-rowid="@r.ExtractRowId">
                                        <i class="bi bi-arrow-left-right"></i> Reassign
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ───────── single reassign ───────── -->
<div class="modal fade rs-modal" id="reassignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form method="post" action="/Manager/Reassign">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Reassign <span class="gold">pending property</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="BatchId" value="@Model.BatchId" />
                    <input type="hidden" id="mRowId" name="ExtractRowId" />
                    <input type="hidden" id="mFrom" name="FromValuer" />
                    <input type="hidden" name="CurrentValuer" value="@Model.CurrentValuer" />
                    <input type="hidden" name="Sector" value="@Model.Sector" />
                    <input type="hidden" name="Top" value="@Model.Top" />

                    <div class="rs-props">
                        <div><span>Premise ID</span><b id="pPremise">-</b></div>
                        <div><span>Valuation key</span><b id="pVkey">-</b></div>
                        <div><span>Sector</span><b id="pSector">-</b></div>
                        <div><span>Town</span><b id="pTown">-</b></div>
                        <div class="wide"><span>Property description</span><b id="pDesc">-</b></div>
                        <div class="wide"><span>Address</span><b id="pAddress">-</b></div>
                        <div><span>Category</span><b id="pCategory">-</b></div>
                        <div><span>Market value</span><b id="pValue">-</b></div>
                        <div><span>Owner</span><b id="pOwner">-</b></div>
                        <div><span>Scheme / unit</span><b id="pScheme">-</b></div>
                        <div class="wide"><span>Valuer in the LIS extract</span><b id="pLis">-</b></div>
                    </div>

                    <div class="rs-move">
                        <i class="bi bi-person-fill"></i> <span id="mFromText">-</span>
                        <i class="bi bi-arrow-right"></i>
                        <i class="bi bi-person-check-fill to"></i> <span class="to" id="mToText">Select below</span>
                    </div>

                    <div class="mb-3">
                        <div class="rs-label">New valuer (active users)</div>
                        <input type="text" id="mSearch" placeholder="Search by name or username…" class="mb-2" />
                        <select name="ToValuer" id="mTo" required></select>
                        <div class="rs-hint">
                            <label><input type="checkbox" id="mAllSectors" /> Show valuers from all sectors</label>
                            &middot; <span id="mCount"></span>
                        </div>
                    </div>

                    <div>
                        <div class="rs-label">Reason (kept in the audit trail)</div>
                        <textarea name="Reason" required placeholder="Why is this property being reassigned?"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="rs-out" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rs-gold"><i class="bi bi-check-circle-fill"></i> Confirm reassign</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ───────── bulk reassign ───────── -->
<div class="modal fade rs-modal" id="bulkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/Manager/Reassign/Bulk">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-people-fill me-2"></i>Bulk <span class="gold">reassign</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="BatchId" value="@Model.BatchId" />
                    <input type="hidden" name="CurrentValuer" value="@Model.CurrentValuer" />
                    <input type="hidden" name="Sector" value="@Model.Sector" />
                    <input type="hidden" name="Top" value="@Model.Top" />

                    <div class="mgr-alert warn" style="margin-top:0">
                        Moves <strong>all Pending properties</strong> of one valuer in this batch to another. Verified (Yes / No) properties stay where they are.
                    </div>

                    <div class="my-3">
                        <div class="rs-label">From valuer</div>
                        <select name="FromValuer" required>
                            <option value="">Select source valuer</option>
                            @foreach (var v in Model.CurrentValuers)
                            {
                                <option value="@v.Username">@v.Username (@v.Pending pending)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="rs-label">To valuer (active users)</div>
                        <select name="ToValuer" id="bTo" required></select>
                    </div>

                    <div>
                        <div class="rs-label">Reason (kept in the audit trail)</div>
                        <textarea name="Reason" required placeholder="Why is this work being reassigned?"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="rs-out" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rs-gold"><i class="bi bi-people-fill"></i> Confirm bulk reassign</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var rows = @Html.Raw(rowsJson);
            var valuers = @Html.Raw(valuersJson);

            function label(v) { return v.n + ' (' + v.u + ')' + (v.p ? ' - ' + v.p : '') + (v.s ? ' [' + v.s + ']' : ''); }
            function norm(x) { return (x || '').toString().trim().toUpperCase(); }

            // ---- single modal
            var cur = null;
            var sel = document.getElementById('mTo');
            var search = document.getElementById('mSearch');
            var all = document.getElementById('mAllSectors');

            function fillSingle() {
                if (!cur) return;
                var q = norm(search.value);
                var sameSector = valuers.filter(function (v) { return norm(v.s) === norm(cur.sector); });
                var pool = (all.checked || sameSector.length === 0) ? valuers : sameSector;

                var list = pool.filter(function (v) {
                    if (norm(v.u) === norm(cur.from)) return false;
                    return !q || norm(v.n).indexOf(q) >= 0 || norm(v.u).indexOf(q) >= 0;
                });

                sel.innerHTML = '<option value="">- Select new valuer -</option>' +
                    list.map(function (v) { return '<option value="' + v.u.replace(/"/g, '&quot;') + '">' + label(v).replace(/</g, '&lt;') + '</option>'; }).join('');

                document.getElementById('mCount').textContent = list.length + ' active valuer(s)' +
                    ((all.checked || sameSector.length === 0) ? '' : ' in ' + cur.sector);
            }

            function set(id, v) { document.getElementById(id).textContent = (v === null || v === undefined || v === '') ? '-' : v; }

            var modal = document.getElementById('reassignModal');
            modal.addEventListener('show.bs.modal', function (e) {
                var id = e.relatedTarget.getAttribute('data-rowid');
                cur = rows[id];
                if (!cur) return;

                document.getElementById('mRowId').value = id;
                document.getElementById('mFrom').value = cur.from;
                document.getElementById('mFromText').textContent = cur.from;
                document.getElementById('mToText').textContent = 'Select below';

                set('pPremise', cur.premise); set('pVkey', cur.vkey); set('pSector', cur.sector); set('pTown', cur.town);
                set('pDesc', cur.desc); set('pAddress', cur.address); set('pCategory', cur.category);
                set('pValue', cur.value ? 'R ' + cur.value : null); set('pOwner', cur.owner);
                set('pScheme', [cur.scheme, cur.unit ? 'Unit ' + cur.unit : ''].filter(Boolean).join(' / '));
                set('pLis', cur.lis);

                search.value = ''; all.checked = false;
                fillSingle();
            });
            search.addEventListener('input', fillSingle);
            all.addEventListener('change', fillSingle);
            sel.addEventListener('change', function () {
                var t = sel.options[sel.selectedIndex];
                document.getElementById('mToText').textContent = sel.value ? t.text : 'Select below';
            });

            // ---- bulk modal
            document.getElementById('bTo').innerHTML = '<option value="">Select destination valuer</option>' +
                valuers.map(function (v) { return '<option value="' + v.u.replace(/"/g, '&quot;') + '">' + label(v).replace(/</g, '&lt;') + '</option>'; }).join('');

            // ---- table search
            var box = document.getElementById('rowSearch');
            if (box) box.addEventListener('input', function () {
                var q = norm(box.value);
                document.querySelectorAll('#rowsTable tbody tr').forEach(function (tr) {
                    tr.style.display = !q || norm(tr.textContent).indexOf(q) >= 0 ? '' : 'none';
                });
            });
        })();
    </script>
}
