@model Valuer_Verification_System.Controllers.ExtractApprovalVm

@{
    ViewData["Title"] = "Extract Approval";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />



<link href="~/css/upload/batch-css.css" rel="stylesheet" asp-append-version="true"/>
<div class="top-bar">
    <div class="top-bar__brand">
        <div class="top-bar__logo">VVS</div>
        <div>
            <div class="top-bar__name">Valuation Services</div>
            <div class="top-bar__dept">City of Johannesburg · Finance</div>
        </div>
    </div>
    <a class="top-bar__back" href="/ExtractIntake">← Intake</a>
</div>

<div class="ap-page">

  
    <div class="ap-eyebrow">Workflow · Extract Approval</div>
    <h1 class="ap-title">Batch <span>@Model.BatchName</span></h1>
    <p class="ap-sub">Review the cleaned extract summary before notifying Sector Managers.</p>

  
    @if (TempData["ApprovalSuccess"] is not null)
    {
        <div class="alert ok">✓ @TempData["ApprovalSuccess"]</div>
    }
    @if (TempData["ApprovalError"] is not null)
    {
        <div class="alert err">⚠ @TempData["ApprovalError"]</div>
    }


    <div class="status-timeline">
        <div class="st-step @(Model.IsCleaned ? "done" : "active")">
            <div class="st-icon">@(Model.IsCleaned ? "✓" : "⚙")</div>
            <div>
                <div class="st-label">1 · Cleaning</div>
                <div class="st-value">@(Model.IsCleaned ? "Completed" : Model.ExtractCleaningStatus)</div>
            </div>
        </div>
        <div class="st-step @(Model.ProjectManagerApprovedAtUtc != null ? "done" : Model.IsCleaned ? "active" : "wait")">
            <div class="st-icon">@(Model.ProjectManagerApprovedAtUtc != null ? "✓" : "👤")</div>
            <div>
                <div class="st-label">2 · PM Approval</div>
                <div class="st-value">
                    @(Model.ProjectManagerApprovedAtUtc != null
                        ? Model.ProjectManagerApprovedAtUtc?.ToString("yyyy-MM-dd HH:mm")
                        : "Pending")
                </div>
            </div>
        </div>
        <div class="st-step @(Model.SectorManagersNotified ? "done" : Model.ProjectManagerApprovedAtUtc != null ? "active" : "wait")">
            <div class="st-icon">@(Model.SectorManagersNotified ? "✓" : "📧")</div>
            <div>
                <div class="st-label">3 · Notify Sectors</div>
                <div class="st-value">
                    @(Model.SectorManagersNotified
                        ? Model.ManagersNotifiedAtUtc?.ToString("yyyy-MM-dd HH:mm")
                        : "Waiting")
                </div>
            </div>
        </div>
    </div>

  
    <div class="kpi-row">
        <div class="kpi">
            <label>Properties</label>
            <strong>@Model.TotalProperties.ToString("N0")</strong>
        </div>
        <div class="kpi">
            <label>Rows</label>
            <strong>@Model.TotalRows.ToString("N0")</strong>
        </div>
        <div class="kpi">
            <label>Valuers</label>
            <strong>@Model.TotalValuers.ToString("N0")</strong>
        </div>
        <div class="kpi @(Model.TotalUnmatchedRows > 0 ? "warn" : "")">
            <label>Unmatched Rows</label>
            <strong>@Model.TotalUnmatchedRows.ToString("N0")</strong>
        </div>
    </div>

 
    <div class="ap-layout">

        
        <div>

           
            <div class="card">
                <div class="card__head">
                    <div class="card__accent"></div>
                    <div class="card__title">Batch Details</div>
                </div>
                <div class="card__body">
                    <div class="summary-grid">
                        <div class="s-box">
                            <label>Week Period</label>
                            <strong>@Model.WeekStart.ToString("yyyy-MM-dd") → @Model.WeekEnd.ToString("yyyy-MM-dd")</strong>
                        </div>
                        <div class="s-box">
                            <label>Notice Send Date</label>
                            <strong>@Model.NoticeSendDate.ToString("yyyy-MM-dd")</strong>
                        </div>
                        <div class="s-box">
                            <label>Review Period</label>
                            <strong>@Model.ReviewOpenDate.ToString("yyyy-MM-dd") — @Model.ReviewCloseDate.ToString("yyyy-MM-dd")</strong>
                        </div>
                        <div class="s-box">
                            <label>Cleaning Status</label>
                            <strong>@Model.ExtractCleaningStatus</strong>
                        </div>
                        <div class="s-box">
                            <label>Cleaned At</label>
                            <strong>@(Model.ExtractCleanedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC</strong>
                        </div>
                        <div class="s-box">
                            <label>Week Table</label>
                            <strong style="font-size:11px;word-break:break-all;">@Model.CleanWeekTableName</strong>
                        </div>
                        <div class="s-box">
                            <label>PM Notified</label>
                            <strong>@(Model.ProjectManagerNotifiedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</strong>
                        </div>
                        <div class="s-box">
                            <label>Sector Managers</label>
                            <strong>@(Model.ManagersNotifiedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Not yet")</strong>
                        </div>
                        <div class="s-box full">
                            <label>Cleaning Details</label>
                            <strong style="font-size:11px;line-height:1.6;font-weight:500;">@Model.ExtractCleaningMessage</strong>
                        </div>
                    </div>
                </div>
            </div>

          
            <div class="card">
                <div class="card__head">
                    <div class="card__accent"></div>
                    <div class="card__title">Sector Breakdown</div>
                </div>
                <div class="card__body" style="padding:0;">
                    <div class="tbl-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sector</th>
                                    <th class="num">Properties</th>
                                    <th class="num">Rows</th>
                                    <th class="num">Valuers</th>
                                    <th class="num">Unmatched</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sectors)
                                {
                                    <tr>
                                        <td><strong style="font-weight:700;">@s.Sector</strong></td>
                                        <td class="num">@s.TotalProperties.ToString("N0")</td>
                                        <td class="num">@s.TotalRows.ToString("N0")</td>
                                        <td class="num">@s.TotalValuers.ToString("N0")</td>
                                        <td class="num" style="@(s.UnmatchedRows > 0 ? "color:var(--red-text);font-weight:700;" : "")">
                                            @s.UnmatchedRows.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        
            @if (Model.UnmatchedValuers.Any())
            {
                <div class="danger-block">
                    <span class="state-ico">⚠️</span>
                    <span>
                        There are <strong>@Model.UnmatchedValuers.Count unmatched valuer rows</strong>.
                        You can still approve, but those rows will not appear in any valuer's inbox until the name is fixed in the Sectors table.
                    </span>
                </div>

                <div class="card">
                    <div class="card__head">
                        <div class="card__accent" style="background:var(--red-text);"></div>
                        <div class="card__title" style="color:var(--red-text);">Unmatched Valuer Summary</div>
                    </div>
                    <div class="card__body" style="padding:0;">
                        <div class="tbl-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Extract Valuer</th>
                                        <th class="num">Properties</th>
                                        <th class="num">Rows</th>
                                        <th>Status</th>
                                        <th>Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.UnmatchedValuers)
                                    {
                                        <tr>
                                            <td>
                                                <span style="font-family:monospace;font-size:11px;font-weight:700;
                                                             background:var(--ink);color:var(--gold);
                                                             padding:2px 7px;border-radius:4px;">
                                                    @u.Valuer
                                                </span>
                                            </td>
                                            <td class="num">@u.Properties.ToString("N0")</td>
                                            <td class="num">@u.Rows.ToString("N0")</td>
                                            <td>
                                                <span style="font-size:11px;font-weight:700;padding:2px 8px;
                                                             border-radius:20px;background:var(--red-bg);color:var(--red-text);">
                                                    @u.MatchStatus
                                                </span>
                                            </td>
                                            <td style="font-size:11px;color:var(--ink3);">@u.MatchComment</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div>

           
            <div class="side-card">
                <div class="side-card__head">
                    <div class="side-card__icon">📋</div>
                    <div class="side-card__title">Approval Action</div>
                </div>
                <div class="side-card__body">
                    @if (Model.SectorManagersNotified)
                    {
                        <div class="notified-block">
                            <span class="state-ico">✅</span>
                            <span>
                                Sector Managers notified by <strong>@Model.ManagersNotifiedBy</strong>
                                on <strong>@Model.ManagersNotifiedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC</strong>.
                                No further action required.
                            </span>
                        </div>
                    }
                    else if (!Model.IsCleaned)
                    {
                        <div class="locked-block">
                            <span class="state-ico">🔒</span>
                            <span>The extract must be cleaned successfully before Sector Managers can be notified.</span>
                        </div>
                    }
                    else
                    {
                        <form method="post" action="/ExtractApproval/Batch/@Model.BatchId/NotifySectorManagers">
                            @Html.AntiForgeryToken()

                            <span class="approve-label">Approval comment (optional)</span>
                            <textarea class="approve-textarea"
                                      name="comment"
                                      placeholder="Add a note before notifying Sector Managers…"></textarea>

                            <label class="approve-check">
                                <input type="checkbox" required />
                                I reviewed this extract summary and approve notifying Sector Managers.
                            </label>

                            <button class="btn-approve" type="submit">
                                ✓ Approve &amp; Notify Sector Managers
                            </button>
                        </form>
                    }
                </div>
            </div>

            
            <div class="side-card">
                <div class="side-card__head">
                    <div class="side-card__icon">📦</div>
                    <div class="side-card__title">Batch Quick Reference</div>
                </div>
                <div class="side-card__body">
                    <div class="meta-row">
                        <div class="lbl">Batch</div>
                        <div class="val" style="font-weight:800;color:var(--ink);font-size:14px;">@Model.BatchName</div>
                    </div>
                    <div class="meta-row">
                        <div class="lbl">Week</div>
                        <div class="val">@Model.WeekStart.ToString("dd MMM yyyy") — @Model.WeekEnd.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="meta-row">
                        <div class="lbl">Notice Date</div>
                        <div class="val gold">@Model.NoticeSendDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="meta-row">
                        <div class="lbl">Review Period</div>
                        <div class="val">@Model.ReviewOpenDate.ToString("dd MMM") — @Model.ReviewCloseDate.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
